# AgentBI local development configuration

# SMTP is used by login codes and the email subagent.
EMAIL_HOST=smtp.example.com
EMAIL_FROM=
EMAIL_PASSWORD=

# Local SQLite location. Leave empty to use AgentBI/data/agentbi.sqlite3.
CHAT_SQLITE_PATH=

# Bundled NeteaseCloudMusicApiEnhanced service.
NCM_ENABLED=true
NCM_COOKIE=
NCM_API_PORT=3300
NCM_AUDIO_LEVEL=standard
NCM_STARTUP_TIMEOUT_SECONDS=15

# bilibili-cli executable used for public video search.
# Install once with: uv tool install bilibili-cli
BILI_CLI_COMMAND=bili

# Optional provider-facing request header.
LLM_USER_AGENT=
