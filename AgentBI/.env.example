# AgentBI local development configuration

# Toolbox TTS providers. Generated audio is not persisted.
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
MIMO_API_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_ICL_RESOURCE_ID=seed-icl-2.0

# SMTP is used by login codes and the email subagent.
EMAIL_HOST=smtp.example.com
EMAIL_FROM=
EMAIL_PASSWORD=

# Local SQLite location. Leave empty to use AgentBI/data/agentbi.sqlite3.
CHAT_SQLITE_PATH=

# Bundled NeteaseCloudMusicApiEnhanced service.
NCM_ENABLED=true
NCM_COOKIE=
NCM_API_PORT=3300
NCM_AUDIO_LEVEL=standard
NCM_STARTUP_TIMEOUT_SECONDS=15

# bilibili-cli executable used for public video search.
# Install once with: uv tool install bilibili-cli
BILI_CLI_COMMAND=bili

# Tavily lightweight web search tool.
TAVILY_API_KEY=

# Optional provider-facing request header.
LLM_USER_AGENT=
# Agnes Video v2.0 asynchronous text-to-video tool.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
