# ============================================================
# AgentBI Monorepo .gitignore
# 覆盖 Python 后端 + Node 前端 + IDE + OS 全场景
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# 虚拟环境（可再生，不入库）
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python 类型检查/测试缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# ---------- Node / 前端 ----------
node_modules/
dist-ssr/
*.local
.eslintcache
.oxlintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite 临时文件
*.timestamp-*-*.mjs

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 日志 ----------
logs/
*.log

# ---------- IDE ----------
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- 备份压缩包 ----------
*_backup_*.zip
*.bak
*.tmp

# ---------- Local chat storage ----------
AgentBI/data/
# Project-owned Codex OAuth credentials (keep explicit even though data/ is ignored)
codex-image-oauth.json
codex-image-oauth.json.tmp

# ---------- 无关参考文件 ----------
工具箱/
code/

# ---------- 编码代理临时文件 ----------
.agents/
.codex/
.uploads/
.superpowers/

# ---------- 本地测试与过程材料 ----------
/AgentBI/tests/
/Agent-vue/tests/
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
/Agent-vue/vitest.config.ts
/scripts/check-startup.py
/.github/workflows/check.yml
/docs/development.md
/docs/verification.md
/docs/screenshots/
/docs/plans/
/docs/reviews/
/docs/verification/
/.playwright-cli/
playwright-report/
test-results/
coverage/
